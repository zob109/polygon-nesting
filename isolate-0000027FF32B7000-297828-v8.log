script-source,124,node:internal/fs/sync_write_stream,'use strict';\x0d\n\x0d\nconst {\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  ReflectApply\x2C\x0d\n} = primordials;\x0d\nconst { kEmptyObject } = require('internal/util');\x0d\n\x0d\nconst { Writable } = require('stream');\x0d\nconst { closeSync\x2C writeSync } = require('fs');\x0d\n\x0d\nfunction SyncWriteStream(fd\x2C options) {\x0d\n  ReflectApply(Writable\x2C this\x2C [{ autoDestroy: true }]);\x0d\n\x0d\n  options ||= kEmptyObject;\x0d\n\x0d\n  this.fd = fd;\x0d\n  this.readable = false;\x0d\n  this.autoClose = options.autoClose === undefined ? true : options.autoClose;\x0d\n}\x0d\n\x0d\nObjectSetPrototypeOf(SyncWriteStream.prototype\x2C Writable.prototype);\x0d\nObjectSetPrototypeOf(SyncWriteStream\x2C Writable);\x0d\n\x0d\nSyncWriteStream.prototype._write = function(chunk\x2C encoding\x2C cb) {\x0d\n  try {\x0d\n    writeSync(this.fd\x2C chunk\x2C 0\x2C chunk.length);\x0d\n  } catch (e) {\x0d\n    cb(e);\x0d\n    return;\x0d\n  }\x0d\n  cb();\x0d\n};\x0d\n\x0d\nSyncWriteStream.prototype._destroy = function(err\x2C cb) {\x0d\n  if (this.fd === null) // already destroy()ed\x0d\n    return cb(err);\x0d\n\x0d\n  if (this.autoClose)\x0d\n    closeSync(this.fd);\x0d\n\x0d\n  this.fd = null;\x0d\n  cb(err);\x0d\n};\x0d\n\x0d\nSyncWriteStream.prototype.destroySoon =\x0d\n  SyncWriteStream.prototype.destroy;\x0d\n\x0d\nmodule.exports = SyncWriteStream;\x0d\n
