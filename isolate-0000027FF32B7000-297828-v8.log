 var imb = ay < by ? ay : by\x2C imt = ay < by ? by : ay;\x0d\n      if (imr < GB.l - EPS || iml > GB.r + EPS) continue;\x0d\n      if (imt < GB.b - EPS || imb > GB.t + EPS) continue;\x0d\n\x0d\n      gx0 = Math.floor((iml - ei.bbox.l) / cell);\x0d\n      gx1 = Math.floor((imr - ei.bbox.l) / cell);\x0d\n      gy0 = Math.floor((imb - ei.bbox.b) / cell);\x0d\n      gy1 = Math.floor((imt - ei.bbox.b) / cell);\x0d\n      if (gx0 < 0) gx0 = 0;\x0d\n      if (gy0 < 0) gy0 = 0;\x0d\n      if (gx1 > ei.nx - 1) gx1 = ei.nx - 1;\x0d\n      if (gy1 > ei.ny - 1) gy1 = ei.ny - 1;\x0d\n\x0d\n      for (gy = gy0; gy <= gy1; gy++) {\x0d\n        for (gx = gx0; gx <= gx1; gx++) {\x0d\n          arr = ei.grid[gy * nx + gx];\x0d\n          if (!arr) continue;\x0d\n          for (ai = 0; ai < arr.length; ai++) {\x0d\n            var j = arr[ai];\x0d\n            if (stamp[j] === tick) continue;\x0d\n            stamp[j] = tick;\x0d\n            var c = boundary[j]\x2C d = boundary[(j + 1) % nb];\x0d\n            if (imr < Math.min(c.x\x2C d.x) - EPS || iml > Math.max(c.x\x2C d.x) + EPS) continue;\x0d\n            if (imt < Math.min(c.y\x2C d.y) - EPS || imb > Math.max(c.y\x2C d.y) + EPS) continue;\x0d\n            if (segInteriorNum(ax\x2C ay\x2C bx\x2C by\x2C c.x\x2C c.y\x2C d.x\x2C d.y)) return false;\x0d\n          }\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n\x0d\n    var mb = boxMoved(ctx.polys[idx].bbox\x2C trans);\x0d\n    var center = V((mb.l + mb.r) * 0.5\x2C (mb.b + mb.t) * 0.5);\x0d\n    return pointInPoly(center\x2C boundary);\x0d\n  }\x0d\n\x0d\n  function checkCollision(ctx\x2C idx\x2C trans\x2C placed\x2C trs) {\x0d\n    _dbg.check++;\x0d\n    var P = ctx.polys[idx];\x0d\n    var pb = P.bbox;\x0d\n    var ml = pb.l + trans.x\x2C mr = pb.r + trans.x;\x0d\n    var mbb = pb.b + trans.y\x2C mt = pb.t + trans.y;\x0d\n    var GB = ctx.GBound;\x0d\n    if (ml < GB.l - EPS || mr > GB.r + EPS || mbb < GB.b - EPS || mt > GB.t + EPS) return true;\x0d\n    if (!polyInBoundary(ctx\x2C idx\x2C trans)) return true;\x0d\n\x0d\n    var shape = ctx.shapes[P.shape_id];\x0d\n    var ocx = P.shape_offset.x + trans.x\x2C ocy = P.shape_offset.y + trans.y;\x0d\n\x0d\n    for (var k = 0; k < placed.length; k++) {\x0d\n      var o = placed[k];\x0d\n      var Q = ctx.polys[o];\x0d\n      var qb = Q.bbox\x2C qt = trs[o];\x0d\n      var ql = qb.l + qt.x\x2C qr = qb.r + qt.x;\x0d\n      var qbb = qb.b + qt.y\x2C qtt = qb.t + qt.y;\x0d\n      if (qr < ml - EPS || ql > mr + EPS || qtt < mbb - EPS || qbb > mt + EPS) continue;\x0d\n      var so = ctx.shapes[Q.shape_id];\x0d\n      if (overlapBVH(0\x2C shape\x2C ocx\x2C ocy\x2C 0\x2C so\x2C Q.shape_offset.x + qt.x\x2C Q.shape_offset.y + qt.y)) return true;\x0d\n    }\x0d\n    return false;\x0d\n  }\x0d\n\x0d\n  function checkCollisionAll(ctx\x2C idx\x2C trans\x2C trs) {\x0d\n    var P = ctx.polys[idx];\x0d\n    var pb = P.bbox;\x0d\n    var ml = pb.l + trans.x\x2C mr = pb.r + trans.x;\x0d\n    var mbb = pb.b + trans.y\x2C mt = pb.t + trans.y;\x0d\n    var GB = ctx.GBound;\x0d\n    if (ml < GB.l - EPS || mr > GB.r + EPS || mbb < GB.b - EPS || mt > GB.t + EPS) return true;\x0d\n    if (!polyInBoundary(ctx\x2C idx\x2C trans)) return true;\x0d\n\x0d\n    var shape = ctx.shapes[P.shape_id];\x0d\n    var ocx = P.shape_offset.x + trans.x\x2C ocy = P.shape_offset.y + trans.y;\x0d\n\x0d\n    for (var o = 0; o < ctx.n; o++) {\x0d\n      if (o === idx) continue;\x0d\n      var Q = ctx.polys[o];\x0d\n      var qb = Q.bbox\x2C qt = trs[o];\x0d\n      var ql = qb.l + qt.x\x2C qr = qb.r + qt.x;\x0d\n      var qbb = qb.b + qt.y\x2C qtt = qb.t + qt.y;\x0d\n      if (qr < ml - EPS || ql > mr + EPS || qtt < mbb - EPS || qbb > mt + EPS) continue;\x0d\n      var so = ctx.shapes[Q.shape_id];\x0d\n      if (overlapBVH(0\x2C shape\x2C ocx\x2C ocy\x2C 0\x2C so\x2C Q.shape_offset.x + qt.x\x2C Q.shape_offset.y + qt.y)) return true;\x0d\n    }\x0d\n    return false;\x0d\n  }\x0d\n\x0d\n  /* ============================ \u51f8\u5305 / NFP ============================ */\x0d\n\x0d\n  function convexHull(pts) {\x0d\n    if (pts.length < 3) return pts.slice();\x0d\n    var p = pts.slice().sort(function (a\x2C b) {\x0d\n      return Math.abs(a.x - b.x) > EPS ? a.x - b.x : a.y - b.y;\x0d\n    });\x0d\n    var uniq = [p[0]];\x0d\n    for (var i = 1; i < p.length; i++) {\x0d\n      var last = uniq[uniq.length - 1];\x0d\n      if (Math.abs(last.x - p[i].x) < 1e-9 && Math.abs(last.y - p[i].y) < 1e-9) continue;\x0d\n      uniq.push(p[i]);\x0d\n    }\x0d\n    p = uniq;\x0d\n    var n = p.length;\x0d\n    if (n < 3) return p;\x0d\n\x0d\n    var h = new Array(2 * n);\x0d\n    var k = 0\x2C t;\x0d\n    for (i = 0; i < n; i++) {\x0d\n      while (k >= 2 && vcross(vsub(h[k - 1]\x2C h[k - 2])\x2C vsub(p[i]\x2C h[k - 2])) <= EPS) k--;\x0d\n      h[k++] = p[i];\x0d\n    }\x0d\n    t = k + 1;\x0d\n    for (i = n - 2; i >= 0; i--) {\x0d\n      while (k >= t && vcross(vsub(h[k - 1]\x2C h[k - 2])\x2C vsub(p[i]\x2C h[k - 2])) <= EPS) k--;\x0d\n      h[k++] = p[i];\x0d\n    }\x0d\n    h.length = k - 1;\x0d\n    return h;\x0d\n  }\x0d\n\x0d\n  // \u4e24\u4e2a\u9006\u65f6\u9488\u51f8\u5305\u7684 Minkowski \u548c\uff08\u8fb9\u5411\u91cf\u6309\u6781\u89d2\u5f52\u5e76\uff0cO(n+m)\uff09\x0d\n  function minkowskiSum(P\x2C Q) {\x0d\n    var n = P.length\x2C m = Q.length;\x0d\n    if (!n || !m) return [];\x0d\n    if (n === 1) return Q.map(function (q) { return V(P[0].x + q.x\x2C P[0].y + q.y); });\x0d\n    if (m === 1) return P.map(function (p) { return V(p.x + Q[0].x\x2C p.y + Q[0].y); });\x0d\n\x0d\n    function lowest(A) {\x0d\n      var best = 0;\x0d\n      for (var i = 1; i < A.length; i++) {\x0d\n        if (A[i].y < A[best].y || (A[i].y === A[best].y && A[i].x < A[best].x)) best = i;\x0d\n      }\x0d\n      return best;\x0d\n    }\x0d\n    var pi = lowest(P)\x2C qi = lowest(Q);\x0d\n    var eP = []\x2C eQ = []\x2C i;\x0d\n    for (i = 0; i < n; i++) {\x0d\n      var a = P[(pi + i) % n]\x2C b = P[(pi + i + 1) % n];\x0d\n      eP.push({ x: b.x - a.x\x2C y: b.y - a.y });\x0d\n    }\x0d\n    for (i = 0; i < m; i++) {\x0d\n      var c = Q[(qi + i) % m]\x2C d = Q[(qi + i + 1) % m];\x0d\n      eQ.push({ x: d.x - c.x\x2C y: d.y - c.y });\x0d\n    }\x0d\n\x0d\n    var cur = V(P[pi].x + Q[qi].x\x2C P[pi].y + Q[qi].y);\x0d\n    var out = [V(cur.x\x2C cur.y)];\x0d\n    var ia = 0\x2C ib = 0;\x0d\n    while (ia < n || ib < m) {\x0d\n      if (ia >= n) {\x0d\n        cur = vadd(cur\x2C eQ[ib]); ib++;\x0d\n      } else if (ib >= m) {\x0d\n        cur = vadd(cur\x2C eP[ia]); ia++;\x0d\n      } else {\x0d\n        var cr = vcross(eP[ia]\x2C eQ[ib]);\x0d\n        if (cr > 0) { cur = vadd(cur\x2C eP[ia]); ia++; }\x0d\n        else if (cr < 0) { cur = vadd(cur\x2C eQ[ib]); ib++; }\x0d\n        else { cur = vadd(cur\x2C vadd(eP[ia]\x2C eQ[ib])); ia++; ib++; }\x0d\n      }\x0d\n      out.push(V(cur.x\x2C cur.y));\x0d\n    }\x0d\n    out.pop();\x0d\n    return out;\x0d\n  }\x0d\n\x0d\n  function shapeHull(shape) {\x0d\n    if (!shape._hull) shape._hull = convexHull(shape.pts);\x0d\n    return shape._hull;\x0d\n  }\x0d\n\x0d\n  function getNFP(ctx\x2C a\x2C b) {\x0d\n    var row = ctx.nfp[a];\x0d\n    if (!row) row = ctx.nfp[a] = [];\x0d\n    var nd = row[b];\x0d\n    if (nd) return nd;\x0d\n\x0d\n    var hA = shapeHull(ctx.shapes[a]);\x0d\n    var hB = shapeHull(ctx.shapes[b]);\x0d\n    var negB = hB.map(function (p) { return V(-p.x\x2C -p.y); }).reverse();\x0d\n    var hull = minkowskiSum(hA\x2C negB);\x0d\n\x0d\n    var edges = new Array(hull.length);\x0d\n    for (var k = 0; k < hull.length; k++) {\x0d\n      var A = hull[k]\x2C B = hull[(k + 1) % hull.length];\x0d\n      edges[k] = { A: A\x2C B: B\x2C d2: Math.min(A.x * A.x + A.y * A.y\x2C B.x * B.x + B.y * B.y) };\x0d\n    }\x0d\n    nd = { hull: hull\x2C edges: edges };\x0d\n    row[b] = nd;\x0d\n    return nd;\x0d\n  }\x0d\n\x0d\n  /* ============================ \u653e\u7f6e ============================ */\x0d\n\x0d\n  function ensureGrid(ctx) {\x0d\n    