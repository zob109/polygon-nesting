      name\x2C\x0d\n      value\x2C\x0d\n      'must be an array or string of format "</styles.css>; rel=preload; as=style"'\x2C\x0d\n    );\x0d\n  }\x0d\n});\x0d\n\x0d\n/**\x0d\n * Validate provided `this` object by checking that it has specific own property\x0d\n * @param {any} object\x0d\n * @param {string|symbol} fieldKey\x0d\n * @param {string} className\x0d\n */\x0d\nconst validateThisInternalField = hideStackFrames((object\x2C fieldKey\x2C className) => {\x0d\n  if (typeof object !== 'object' || object === null || !ObjectPrototypeHasOwnProperty(object\x2C fieldKey)) {\x0d\n    throw new ERR_INVALID_THIS(className);\x0d\n  }\x0d\n});\x0d\n\x0d\n/**\x0d\n * @param {any} hints\x0d\n * @return {string}\x0d\n */\x0d\nconst validateLinkHeaderValue = hideStackFrames((hints) => {\x0d\n  if (typeof hints === 'string') {\x0d\n    validateLinkHeaderFormat.withoutStackTrace(hints\x2C 'hints');\x0d\n    return hints;\x0d\n  } else if (ArrayIsArray(hints)) {\x0d\n    const hintsLength = hints.length;\x0d\n    let result = '';\x0d\n\x0d\n    if (hintsLength === 0) {\x0d\n      return result;\x0d\n    }\x0d\n\x0d\n    for (let i = 0; i < hintsLength; i++) {\x0d\n      const link = hints[i];\x0d\n      validateLinkHeaderFormat.withoutStackTrace(link\x2C 'hints');\x0d\n      result += link;\x0d\n\x0d\n      if (i !== hintsLength - 1) {\x0d\n        result += '\x2C ';\x0d\n      }\x0d\n    }\x0d\n\x0d\n    return result;\x0d\n  }\x0d\n\x0d\n  throw new ERR_INVALID_ARG_VALUE(\x0d\n    'hints'\x2C\x0d\n    hints\x2C\x0d\n    'must be an array or string of format "</styles.css>; rel=preload; as=style"'\x2C\x0d\n  );\x0d\n});\x0d\n\x0d\n// 1. Returns false for undefined and NaN\x0d\n// 2. Returns true for finite numbers\x0d\n// 3. Throws ERR_INVALID_ARG_TYPE for non-numbers\x0d\n// 4. Throws ERR_OUT_OF_RANGE for infinite numbers\x0d\nconst validateFiniteNumber = hideStackFrames((number\x2C name) => {\x0d\n  // Common case\x0d\n  if (number === undefined) {\x0d\n    return false;\x0