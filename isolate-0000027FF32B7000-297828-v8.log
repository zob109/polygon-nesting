\x0d\n        bestCost = c; bestOrder = orders[i].order; bestTrans = trs; bestName = orders[i].name;\x0d\n      }\x0d\n      if (onProgress) onProgress({ stage: 'orders'\x2C done: i + 1\x2C total: limit\x2C best: bestCost });\x0d\n    }\x0d\n\x0d\n    if (!bestOrder) {\x0d\n      return { error: '\u6240\u6709\u542f\u53d1\u5f0f\u987a\u5e8f\u90fd\u65e0\u6cd5\u5b8c\u6210\u653e\u7f6e\uff0c\u53ef\u80fd\u9762\u79ef\u8d85\u51fa\u8fb9\u754c\u3002' };\x0d\n    }\x0d\n\x0d\n    table.sort(function (a\x2C b) { return a.cost - b.cost; });\x0d\n\x0d\n    frames.push(snapshot(ctx\x2C 'order'\x2C\x0d\n      '\u542f\u53d1\u5f0f\u7b5b\u9009 \xb7 \u6bd4\u8f83\u4e86 ' + limit + ' \u79cd\u653e\u7f6e\u987a\u5e8f\uff0c\u6700\u4f18\u4e3a\u300c' + bestName +\x0d\n      '\u300d\uff0c\u6b64\u65f6 \u03a3|trans| = ' + bestCost.toFixed(3) + '\u3002\u4e0b\u9762\u6309\u8fd9\u4e2a\u987a\u5e8f\u91cd\u65b0\u9010\u4e2a\u653e\u7f6e'\x2C\x0d\n      zero\x2C []\x2C -1\x2C { meta: { table: table.slice(0\x2C limit)\x2C best: bestName } }));\x0d\n\x0d\n    // \u9010\u6b65\u91cd\u653e\u6700\u4f18\u987a\u5e8f\x0d\n    if (onProgress) onProgress({ stage: 'replay'\x2C done: 0\x2C total: n });\x0d\n    var trace = [];\x0d\n    var replayCost = decodeOrder(ctx\x2C bestOrder\x2C bestTrans\x2C opts.compactRounds\x2C opts\x2C trace);\x0d\n    for (i = 0; i < trace.length; i++) frames.push(trace[i]);\x0d\n    if (onProgress) onProgress({ stage: 'replay'\x2C done: n\x2C total: n });\x0d\n\x0d\n    var trueCost = replayCost < bestCost ? replayCost : bestCost;\x0d\n    var trueTrans = replayCost < bestCost ? bestTrans : bestTrans;\x0d\n\x0d\n    // \u6a21\u62df\u9000\u706b\x0d\n    var saStart = Date.now();\x0d\n    var improved = 0;\x0d\n    if (opts.saIter > 0) {\x0d\n      var rng = mulberry32(20260428);\x0d\n      var T0 = 2000.0\x2C Tend = 0.02;\x0d\n      var cur = bestOrder.slice();\x0d\n      var fastTrs = [];\x0d\n      var bestFast = decodeOrder(ctx\x2C cur\x2C fastTrs\x2C 0\x2C opts\x2C null);\x0d\n      var