script-source,123,C:\\Users\\Admin\\WorkBuddy\\2026-11-16-22-50-34\\polygon-nesting\\assets\\solver.js,/*\x0d\n * solver.js \u2014 \u591a\u8fb9\u5f62\u6392\u6837\u6c42\u89e3\u5668\uff08\u6d4f\u89c8\u5668\u53ef\u8fd0\u884c\u7248\uff09\x0d\n *\x0d\n * \u79fb\u690d\u81ea Solution.cpp\u3002\u539f\u7b97\u6cd5\u7684\u4e94\u4e2a\u9636\u6bb5\uff1a\x0d\n *   1. \u4e09\u89d2\u5256\u5206 + BVH \u6784\u5efa\x0d\n *   2. NFP \u51f8\u5305\u8fd1\u4f3c\uff08Minkowski \u5dee\u7684\u51f8\u5305\uff09\x0d\n *   3. \u987a\u5e8f\u653e\u7f6e\uff08NFP \u9876\u70b9 / \u8fb9\u91c7\u6837 / \u7f51\u683c\u56de\u9000 / \u8fb9\u4ea4\u70b9\uff09\x0d\n *   4. \u5168\u5c40\u538b\u7f29\uff08\u6240\u6709\u591a\u8fb9\u5f62\u671d\u539f\u70b9\u6536\u7f29\uff09\x0d\n *   5. \u6a21\u62df\u9000\u706b\uff08\u6270\u52a8\u653e\u7f6e\u987a\u5e8f\uff09\x0d\n *\x0d\n * \u95ee\u9898\u5b9a\u4e49\u4e0d\u53d8\uff1a\u6700\u5c0f\u5316 \u03a3|trans_i|\uff0c\u7ea6\u675f\u4e3a\u4e24\u4e24\u4e0d\u91cd\u53e0\u3001\u5168\u90e8\u4f4d\u4e8e\u8fb9\u754c\u591a\u8fb9\u5f62\u5185\u3001\u53ea\u5141\u8bb8\u5e73\u79fb\u3002\x0d\n *\x0d\n * \u4e0e\u539f C++ \u5b9e\u73b0\u7684\u5dee\u5f02\uff08\u4e3a\u4e86\u8ba9\u6d4f\u89c8\u5668\u8dd1\u5f97\u52a8\uff0c\u4e0d\u6539\u53d8\u95ee\u9898\u5b9a\u4e49\uff09\uff1a\x0d\n *   1. NFP \u7528\u4e24\u6761\u51f8\u5305\u7684 Minkowski \u548c\u505a\u8fb9\u5f52\u5e76\uff0cO(n+m)\uff0c\u6570\u5b66\u4e0a\u7b49\u4ef7\u4e8e\u539f\u70b9\u96c6\u4e24\u4e24\u5dee\u503c\u7684\u51f8\u5305\uff1b\x0d\n *   2. \u8fb9\u754c\u5185\u542b\u5224\u5b9a\u52a0\u4e86\u5747\u5300\u7f51\u683c\u7d22\u5f15\uff0c\u907f\u514d 172 \u8fb9\u5f62 \xd7 28 \u6761\u8fb9\u754c\u8fb9\u7684\u5168\u5bf9\u68c0\u6d4b\uff1b\x0d\n *   3. \u4e25\u683c inner-NFP\uff08\u6805\u683c\u5316 + Moore \u8f6e\u5ed3\u8ffd\u8e2a\uff0c\u7ea6 400 \u884c\uff09\u672a\u79fb\u690d\uff0c\x0d\n *      \u6539\u7528\u8fb9\u754c\u9876\u70b9\u4f5c\u5019\u9009\u79cd\u5b50\uff1b\u5408\u6cd5\u6027\u4ecd\u7531 polyInBoundary \u4e25\u683c\u6821\u9a8c\uff0c\u4e0d\u4f1a\u4ea7\u751f\u8d8a\u754c\u89e3\uff1b\x0d\n *   4. \u5019\u9009\u91c7\u6837\u6b65\u957f\u3001\u987a\u5e8f\u6570\u91cf\u3001\u9000\u706b\u8fed\u4ee3\u6b21\u6570\u7531 quality \u9884\u8bbe\u63a7\u5236\uff0c\u53ef\u7528\u53c2\u6570\u8986\u76d6\u3002\x0d\n */\x0d\n(function (global) {\x0d\n  'use strict';\x0d\n\x0d\n  var EPS = 1e-8;\x0d\n  var INF = 1e18;\x0d\n  var _dbg = { tryV: 0\x2C check: 0\x2C boundary: 0\x2C bvh: 0\x2C place: 0 };\x0d\n\x0d\n  /* ============================ \u57fa\u7840\u51e0\u4f55 ============================ */\x0d\n\x0d\n  function V(x\x2C y) { return { x: x\x2C y: y }; }\x0d\n  function vsub(a\x2C b) { return { x: a.x - b.x\x2C y: a.y - b.y }; }\x0d\n  function vadd(a\x2C b) { return { x: a.x + b.x\x2C y: a.y + b.y }; }\x0d\n  function vdot(a\x2C b) { return a.x * b.x + a.y * b.y; }\x0d\n  function vcross(a\x2C b) { return a.x * b.y - a.y * b.x; }\x0d\n  function vnorm(a) { return Math.sqrt(a.x * a.x + a.y * a.y); }\x0d\n  var ZERO = V(0\x2C 0);\x0d\n\x0d\n  function boxNew() { return { l: INF\x2C b: INF\x2C r: -INF\x2C t: -INF }; }\x0d\n  function boxExpand(bx\x2C p) {\x0d\n    if (p.x < bx.l) bx.l = p.x;\x0d\n    if (p.x > bx.r) bx.r = p.x;\x0d\n    if (p.y < bx.b) bx.b = p.y;\x0d\n    if (p.y > bx.t) bx.t = p.y;\x0d\n  }\x0d\n  function boxOf(pts) {\x0d\n    var bx = boxNew();\x0d\n    for (var i = 0; i < pts.length; i++) boxExpand(bx\x2C pts[i]);\x0d\n    return bx;\x0d\n  }\x0d\n  function boxMoved(bx\x2C off) {\x0d\n    return { l: bx.l + off.x\x2C b: bx.b + off.y\x2C r: bx.r + off.x\x2C t: bx.t + off.y };\x0d\n  }\x0d\n  function boxIntersects(a\x2C b) {\x0d\n    return !(a.r < b.l - EPS || a.l > b.r + EPS || a.t < b.b - EPS || a.b > b.t + EPS);\x0d\n  }\x0d\n  function boxArea(bx) {\x0d\n    if (bx.r < bx.l || bx.t < bx.b) return 0;\x0d\n    return (bx.r - bx.l) * (bx.t - bx.b);\x0d\n  }\x0d\n  function polyAreaAbs(pts) {\x0d\n    var s = 0\x2C n = pts.length;\x0d\n    for (var i = 0; i < n; i++) s += vcross(pts[i]\x2C pts[(i + 1) % n]);\x0d\n    return Math.abs(s) * 0.5;\x0d\n  }\x0d\n\x0d\n  /* ============================ \u4e09\u89d2\u5256\u5206\uff08Ear Clipping\uff09 ============================ */\x0d\n\x0d\n  function isPointInTri(p\x2C a\x2C b\x2C c) {\x0d\n    var c1 = vcross(vsub(b\x2C a)\x2C vsub(p\x2C a));\x0d\n    var c2 = vcross(vsub(c\x2C b)\x2C vsub(p\x2C b));\x0d\n    var c3 = vcross(vsub(a\x2C c)\x2C vsub(p\x2C c));\x0d\n    var hasNeg = (c1 < -EPS) || (c2 < -EPS) || (c3 < -EPS);\x0d\n    var hasPos = (c1 > EPS) || (c2 > EPS) || (c3 > EPS);\x0d\n    return !(hasNeg && hasPos);\x0d\n  }\x0d\n\x0d\n  function makeTri(a\x2C b\x2C c) {\x0d\n    var t = { p: [a\x2C b\x2C c]\x2C bbox: boxNew() };\x0d\n    boxExpand(t.bbox\x2C a); boxExpand(t.bbox\x2C b); boxExpand(t.bbox\x2C c);\x0d\n    return t;\x0d\n  }\x0d\n\x0d\n  function triangulate(src) {\x0d\n    var res = [];\x0d\n    if (!src || src.length < 3) return res;\x0d\n    var pts = src.slice();\x0d\n    var a = 0\x2C n = pts.length\x2C i;\x0d\n    for (i = 0; i < n; i++) a += vcross(pts[i]\x2C pts[(i + 1) % n]);\x0d\n    if (a < 0) pts.reverse();\x0d\n\x0d\n    var rem = pts.slice();\x0d\n    var guard = n * n;\x0d\n    while (rem.length > 3 && guard-- > 0) {\x0d\n      var ok = false;\x0d\n      for (i = 0; i < rem.length; i++) {\x0d\n        var pv = (i === 0) ? rem.length - 1 : i - 1;\x0d\n        var nx = (i + 1) % rem.length;\x0d\n        var p0 = rem[pv]\x2C p1 = rem[i]\x2C p2 = rem[nx];\x0d\n        if (vcross(vsub(p1\x2C p0)\x2C vsub(p2\x2C p1)) <= EPS) continue;\x0d\n        var ear = true;\x0d\n        for (var j = 0; j < rem.length; j++) {\x0d\n          if (j === pv || j === i || j === nx) continue;\x0d\n          if (isPointInTri(rem[j]\x2C p0\x2C p1\x2C p2)) { ear = false; break; }\x0d\n        }\x0d\n        if (ear) {\x0d\n          res.push(makeTri(p0\x2C p1\x2C p2));\x0d\n          rem.splice(i\x2C 1);\x0d\n          ok = true;\x0d\n          break;\x0d\n        }\x0d\n      }\x0d\n      if (!ok) break;\x0d\n    }\x0d\n    if (rem.length >= 3) res.push(makeTri(rem[0]\x2C rem[1]\x2C rem[2]));\x0d\n    return res;\x0d\n  }\x0d\n\x0d\n  /* ============================ BVH ============================ */\x0d\n\x0d\n  function buildBVH(tris) {\x0d\n    var nodes = [];\x0d\n    if (!tris.length) return nodes;\x0d\n    var idx = [];\x0d\n    for (var i = 0; i < tris.length; i++) idx.push(i);\x0d\n\x0d\n    function build(s\x2C e) {\x0d\n      if (s >= e) return -1;\x0d\n      var n = nodes.length;\x0d\n      var node = { bbox: boxNew()\x2C left: -1\x2C right: -1\x2C tri: -1 };\x0d\n      nodes.push(node);\x0d\n      var k;\x0d\n      for (k = s; k < e; k++) {\x0d\n        var tb = tris[idx[k]].bbox;\x0d\n        if (tb.l < node.bbox.l) node.bbox.l = tb.l;\x0d\n        if (tb.r > node.bbox.r) node.bbox.r = tb.r;\x0d\n        if (tb.b < node.bbox.b) node.bbox.b = tb.b;\x0d\n        if (tb.t > node.bbox.t) node.bbox.t = tb.t;\x0d\n      }\x0d\n      if (e - s === 1) { node.tri = idx[s]; return n; }\x0d\n\x0d\n      var mid = s + ((e - s) >> 1);\x0d\n      var cl = INF\x2C cr = -INF\x2C cb = INF\x2C ct = -INF;\x0d\n      for (k = s; k < e; k++) {\x0d\n        var b2 = tris[idx[k]].bbox;\x0d\n        var cx = (b2.l + b2.r) * 0.5\x2C cy = (b2.b + b2.t) * 0.5;\x0d\n        if (cx < cl) cl = cx;\x0d\n        if (cx > cr) cr = cx;\x0d\n        if (cy < cb) cb = cy;\x0d\n        if (cy > ct) ct = cy;\x0d\n      }\x0d\n      var part = idx.slice(s\x2C e);\x0d\n      if (cr - cl > ct - cb) {\x0d\n        part.sort(function (x\x2C y) {\x0d\n          var A = tris[x].bbox\x2C B = tris[y].bbox;\x0d\n          return (A.l + A.r) - (B.l + B.r);\x0d\n        });\x0d\n      } else {\x0d\n        part.sort(function (x\x2C y) {\x0d\n          var A = tris[x].bbox\x2C B = tris[y].bbox;\x0d\n          return (A.b + A.t) - (B.b + B.t);\x0d\n        });\x0d\n      }\x0d\n      for (k = 0; k < part.length; k++) idx[s + k] = part[k];\x0d\n\x0d\n      node.left = build(s\x2C mid);\x0d\n      node.right = build(mid\x2C e);\x0d\n      return n;\x0d\n    }\x0d\n    build(0\x2C idx.length);\x0d\n    return nodes;\x0d\n  }\x0d\n\x0d\n  function makeShape(pts) {\x0d\n    var tris = triangulate(pts);\x0d\n    return { pts: pts\x2C tris: tris\x2C bbox: boxOf(pts)\x2C bvh: buildBVH(tris)\x2C _hull: null };\x0d\n  }\x0d\n\x0d\n  /* ============================ \u4e09\u89d2\u5f62 SAT ============================ */\x0d\n\x0d\n  // \u4e09\u89d2\u5f62 SAT\uff08\u5168\u90e8\u7528\u6570\u503c\u53c2\u6570\uff0c\u907f\u514d\u70ed\u8def\u5f84\u4e0a\u7684\u5bf9\u8c61\u5206\u914d\uff09\x0d\n  function overlapTri(t1\x2C ox1\x2C oy1\x2C t2\x2C ox2\x2C oy2) {\x0d\n    var p;\x0d\n    for (var s = 0; s < 2; s++) {\x0d\n      var a = s === 0 ? t1 : t2;\x0d\n      var oax = s === 0 ? ox1 : ox2\x2C oay = s === 0 ? oy1 : oy2;\x0d\n      var b = s === 0 ? t2 : t1;\x0d\n      var obx = s === 0 ? ox2 : ox1\x2C oby = s === 0 ? oy2 : oy1;\x0d\n      p = a.p;\x0d\n      for (var i = 0; i < 3; i++) {\x0d\n        var p0 = p[i]\x2C p1 = p[(i + 1) % 3];\x0d\n        var axr = -(p1.y - p0.y)\x2C axy = (p1.x - p0.x);\x0d\n        var mnA = INF\x2C mxA = -INF\x2C mnB = INF\x2C mxB = -INF\x2C j\x2C v;\x0d\n        for (j = 0; j < 3; j++) {\x0d\n          v = (p[j].x + oax) * axr + (p[j].y + oay) * axy;\x0d\n          if (v < mnA) mnA = v;\x0d\n          if (v > mxA) mxA = v;\x0d\n        }\x0d\n        var q = b.p;\x0d\n        for (j = 0; j < 3; j++) {\x0d\n          v = (q[j].x + obx) * axr + (q[j].y + oby) * axy;\x0d\n          if (v < mnB) mnB = v;\x0d\n          if (v > mxB) mxB = v;\x0d\n        }\x0d\n        if (mxA <= mnB + EPS || mxB <= mnA + EPS) return false;\x0d\n      }\x0d\n    }\x0d\n    return true;\x0d\n  }\x0d\n\x0d\n  function overlapBVH(nA\x2C sA\x2C oax\x2C oay\x2C nB\x2C sB\x2C obx\x2C oby) {\x0d\n    _dbg.bvh++;\x0d\n    var nodeA = sA.bvh[nA]\x2C nodeB = sB.bvh[nB];\x0d\n    var bA = nodeA.bbox\x2C bB = nodeB.bbox;\x0d\n    var al = bA.l + oax\x2C ar = bA.r + oax\x2C ab = bA.b + oay\x2C at = bA.t + oay;\x0d\n    var bl = bB.l + obx\x2C br = bB.r + obx\x2C bb = bB.b + oby\x2C bt = bB.t + oby;\x0d\n    if (ar < bl - EPS || al > br + EPS || at < bb - EPS || ab > bt + EPS) return false;\x0d\n\x0d\n    var lA = nodeA.left === -1\x2C lB = nodeB.left === -1;\x0d\n    if (lA && lB) return overlapTri(sA.tris[nodeA.tri]\x2C oax\x2C oay\x2C sB.tris[nodeB.tri]\x2C obx\x2C oby);\x0d\n    if (lA) {\x0d\n      return overlapBVH(nA\x2C sA\x2C oax\x2C oay\x2C nodeB.left\x2C sB\x2C obx\x2C oby) ||\x0d\n        overlapBVH(nA\x2C sA\x2C oax\x2C oay\x2C nodeB.right\x2C sB\x2C obx\x2C oby);\x0d\n    }\x0d\n    if (lB) {\x0d\n      return overlapBVH(nodeA.left\x2C sA\x2C oax\x2C oay\x2C nB\x2C sB\x2C obx\x2C oby) ||\x0d\n        overlapBVH(nodeA.right\x2C sA\x2C oax\x2C oay\x2C nB\x2C sB\x2C obx\x2C oby);\x0d\n    }\x0d\n    return overlapBVH(nodeA.left\x2C sA\x2C oax\x2C oay\x2C nB\x2C sB\x2C obx\x2C oby) ||\x0d\n      overlapBVH(nodeA.right\x2C sA\x2C oax\x2C oay\x2C nB\x2C sB\x2C obx\x2C oby);\x0d\n  }\x0d\n\x0d\n  /* ============================ \u8fb9\u754c\u5185\u542b\u5224\u5b9a ============================ */\x0d\n\x0d\n  // \u7ebf\u6bb5\u4e25\u683c\u5185\u90e8\u76f8\u4ea4\uff08\u7eaf\u6570\u503c\u7248\uff0c\u4f9b\u70ed\u8def\u5f84\u4f7f\u7528\uff0c\u907f\u514d\u6784\u9020\u70b9\u5bf9\u8c61\uff09\x0d\n  function segInteriorNum(ax\x2C ay\x2C bx\x2C by\x2C cx\x2C cy\x2C dx\x2C dy) {\x0d\n    var rx = bx - ax\x2C ry = by - ay;\x0d\n    var sx = dx - cx\x2C sy = dy - cy;\x0d\n    var rxs = rx * sy - ry * sx;\x0d\n    if (rxs < 1e-14 && rxs > -1e-14) return false;\x0d\n    var qx = cx - ax\x2C qy = cy - ay;\x0d\n    var t = (qx * sy - qy * sx) / rxs;\x0d\n    if (!(t > 1e-10 && t < 1 - 1e-10)) return false;\x0d\n    var u = (qx * ry - qy * rx) / rxs;\x0d\n    return (u > 1e-10 && u < 1 - 1e-10);\x0d\n  }\x0d\n\x0d\n  function segmentsIntersectInterior(a\x2C b\x2C c\x2C d) {\x0d\n    var rx = b.x - a.x\x2C ry = b.y - a.y;\x0d\n    var sx = d.x - c.x\x2C sy = d.y - c.y;\x0d\n    var rxs = rx * sy - ry * sx;\x0d\n    if (Math.abs(rxs) < 1e-14) return false;\x0d\n    var dx = c.x - a.x\x2C dy = c.y - a.y;\x0d\n    var t = (dx * sy - dy * sx) / rxs;\x0d\n    var u = (dx * ry - dy * rx) / rxs;\x0d\n    var te = 1e-10;\x0d\n    return (t > te && t < 1.0 - te && u > te && u < 1.0 - te);\x0d\n  }\x0d\n\x0d\n  function pointInPoly(p\x2C poly) {\x0d\n    var n = poly.length;\x0d\n    if (n < 3) return false;\x0d\n    var inside = false;\x0d\n    for (var i = 0\x2C j = n - 1; i < n; j = i++) {\x0d\n      var a = poly[j]\x2C b = poly[i];\x0d\n      if ((a.y > p.y) !== (b.y > p.y)) {\x0d\n        var x = a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y);\x0d\n        if (p.x < x) inside = !inside;\x0d\n      }\x0d\n    }\x0d\n    return inside;\x0d\n  }\x0d\n\x0d\n  function makeEdgeIndex(poly\x2C bbox) {\x0d\n    var w = Math.max(bbox.r - bbox.l\x2C 1e-6)\x2C h = Math.max(bbox.t - bbox.b\x2C 1e-6);\x0d\n    var cell = Math.max(0.4\x2C Math.min(w\x2C h) / 26);\x0d\n    var nx = Math.max(1\x2C Math.ceil(w / cell) + 1);\x0d\n    var ny = Math.max(1\x2C Math.ceil(h / cell) + 1);\x0d\n    var grid = new Array(nx * ny);\x0d\n    var n = poly.length;\x0d\n    for (var i = 0; i < n; i++) {\x0d\n      var a = poly[i]\x2C b = poly[(i + 1) % n];\x0d\n      var x0 = Math.floor((Math.min(a.x\x2C b.x) - bbox.l) / cell);\x0d\n      var x1 = Math.floor((Math.max(a.x\x2C b.x) - bbox.l) / cell);\x0d\n      var y0 = Math.floor((Math.min(a.y\x2C b.y) - bbox.b) / cell);\x0d\n      var y1 = Math.floor((Math.max(a.y\x2C b.y) - bbox.b) / cell);\x0d\n      if (x0 < 0) x0 = 0;\x0d\n      if (y0 < 0) y0 = 0;\x0d\n      if (x1 > nx - 1) x1 = nx - 1;\x0d\n      if (y1 > ny - 1) y1 = ny - 1;\x0d\n      for (var gy = y0; gy <= y1; gy++) {\x0d\n        for (var gx = x0; gx <= x1; gx++) {\x0d\n          var k = gy * nx + gx;\x0d\n          if (!grid[k]) grid[k] = [];\x0d\n          grid[k].push(i);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n    return { poly: poly\x2C bbox: bbo