 port.unref();\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction ClonedAbortSignal() {\x0d\n  return new AbortSignal(kDontThrowSymbol\x2C { transferable: true });\x0d\n}\x0d\nClonedAbortSignal.prototype[kDeserialize] = () => {};\x0d\n\x0d\nObjectDefineProperties(AbortSignal.prototype\x2C {\x0d\n  aborted: kEnumerableProperty\x2C\x0d\n});\x0d\n\x0d\nObjectDefineProperty(AbortSignal.prototype\x2C SymbolToStringTag\x2C {\x0d\n  __proto__: null\x2C\x0d\n  writable: false\x2C\x0d\n  enumerable: false\x2C\x0d\n  configurable: true\x2C\x0d\n  value: 'AbortSignal'\x2C\x0d\n});\x0d\n\x0d\ndefineEventHandler(AbortSignal.prototype\x2C 'abort');\x0d\n\x0d\n// https://dom.spec.whatwg.org/#dom-abortsignal-abort\x0d\nfunction abortSignal(signal\x2C reason) {\x0d\n  // 1. If signal is aborted\x2C then return.\x0d\n  if (signal[kAborted]) return;\x0d\n\x0d\n  // 2. Set signal's abort reason to reason if it is given;\x0d\n  //    otherwise to a new "AbortError" DOMException.\x0d\n  signal[kAborted] = true;\x0d\n  signal[kReason] = reason;\x0d\n\x0d\n  // 3. Let dependentSignalsToAbort be a new list.\x0d\n  const dependentSignalsToAbort = ObjectSetPrototypeOf([]\x2C null);\x0d\n\x0d\n  // 4. For each dependentSignal of signal's dependent signals:\x0d\n  signal[kDependantSignals]?.forEach((s) => {\x0d\n    const dependentSignal = s.deref();\x0d\n    // 1. If dependentSignal is not aborted\x2C then:\x0d\n    if (dependentSignal && !dependentSignal[kAborted]) {\x0d\n      // 1. Set dependentSignal's abort reason to signal's abort reason.\x0d\n      dependentSignal[kReason] = reason;\x0d\n      dependentSignal[kAborted] = true;\x0d\n      // 2. Append dependentSignal to dependentSignalsToAbort.\x0d\n      ArrayPrototypePush(dependentSignalsToAbort\x2C dependentSignal);\x0d\n    }\x0d\n  });\x0d\n\x0d\n  // 5. Run the abort steps for signal\x0d\n  runAbort(signal);\x0d\n\x0d\n  // 6. For each dependentSignal of dependentSignalsToAbort\x2C\x0d\n  //    run the abort steps for dependentSignal.\x0d\n  for (let i = 0; i < dependentSignalsToAbort.length; i++) {\x0d\n    const dependentSignal = dependentSignalsToAbort[i];\x0d\n    runAbort(dependentSignal);\x0d\n  }\x0d\n\x0d\n  // Clean up the signal from gcPersistentSignals\x0d\n  gcPersistentSignals.delete(signal);\x0d\n\x0d\n  // If this is a composite signal\x2C also remove all of its source signals from gcPersistentSignals\x0d\n  // when they get dereferenced from the signal's kSourceSignals set\x0d\n  if (signal[kComposite] && signal[kSourceSignals]) {\x0d\n    signal[kSourceSignals].forEach((sourceWeakRef) => {\x0d\n      const sourceSignal = sourceWeakRef.deref();\x0d\n      if (sourceSignal) {\x0d\n        gcPersistentSignals.delete(sourceSignal);\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\n// To run the abort steps for an AbortSignal signal\x0d\nfunction runAbort(signal) {\x0d\n  const event = new Event('abort'\x2C {\x0d\n    [kTrustEvent]: true\x2C\x0d\n  });\x0d\n  signal.dispatchEvent(event);\x0d\n}\x0d\n\x0d\nclass AbortController {\x0d\n  #signal;\x0d\n\x0d\n  /**\x0d\n   * @type {AbortSignal}\x0d\n   */\x0d\n  get signal() {\x0d\n    this.#signal ??= new AbortSignal(kDontThrowSymbol);\x0d\n\x0d\n    return this.#signal;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {any} [reason]\x0d\n   */\x0d\n  abort(reason = new DOMException('This operation was aborted'\x2C 'AbortError')) {\x0d\n    abortSignal(this.#signal ??= new AbortSignal(kDontThrowSymbol)\x2C reason);\x0d\n  }\x0d\n\x0d\n  [customInspectSymbol](depth\x2C options) {\x0d\n    return customInspect(this\x2C {\x0d\n      signal: this.signal\x2C\x0d\n    }\x2C depth\x2C options);\x0d\n  }\x0d\n\x0d\n  static [kMakeTransferable]() {\x0d\n    const controller = new AbortController();\x0d\n    controller.#signal = new AbortSignal(kDontThrowSymbol\x2C { transferable: true });\x0d\n    return controller;\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Enables the AbortSignal to be transferable using structuredClone/postMessage.\x0d\n * @param {AbortSignal} 