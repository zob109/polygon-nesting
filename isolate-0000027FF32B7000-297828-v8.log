script-source,122,C:\\Users\\Admin\\WorkBuddy\\2026-11-16-22-50-34\\polygon-nesting\\tools\\bench.js,'use strict';\nconst fs=require('fs')\x2Cpath=require('path');\nconst S=require('../assets/solver.js');\nconst text=fs.readFileSync(process.argv[2]||path.join(__dirname\x2C'..'\x2C'data'\x2C'default.in')\x2C'utf8');\nconst parsed=S.parseInput(text);\nconst ctx=S.prepare(parsed);\nconst orders=S.generateOrders(ctx);\nconst opts={...S.QUALITY.standard\x2C compactRounds:0\x2C quality:'standard'};\n\nfunction time(label\x2Cfn){const t=Date.now();const r=fn();console.log(label\x2C (Date.now()-t)+'ms');return r;}\n\nS._resetDbg();\nconst order=orders[2].order;\nconst trs=[];\ntime('decodeOrder(1 \u4e2a\u987a\u5e8f\x2C 0 \u8f6e\u538b\u7f29)'\x2C ()=>S.decodeOrder(ctx\x2C order\x2C trs\x2C 0\x2C opts\x2C null));\nconsole.log('  \u03a3|trans| ='\x2C trs.reduce((a\x2Cv)=>a+Math.hypot(v.x\x2Cv.y)\x2C0).toFixed(3));\nconsole.log('  \u8ba1\u6570:'\x2C JSON.stringify(S._dbg));\nconsole.log('  \u6bcf\u6b21\u78b0\u649e\u68c0\u67e5\u7684 BVH \u8282\u70b9\u8bbf\u95ee:'\x2C (S._dbg.bvh/Math.max(1\x2CS._dbg.check)).toFixed(1));\n\nS._resetDbg();\ntime('compact 1 \u8f6e'\x2C ()=>S.decodeOrder(ctx\x2C order\x2C trs\x2C 1\x2C opts\x2C null));\nconsole.log('  \u8ba1\u6570:'\x2C JSON.stringify(S._dbg));\n\nconst t2=Date.now();\nfor(let i=0;i<5;i++){const tt=[];S.decodeOrder(ctx\x2C orders[i].order\x2C tt\x2C 0\x2C opts\x2C null);}\nconsole.log('5 \u4e2a\u987a\u5e8f\u5e73\u5747:'\x2C ((Date.now()-t2)/5).toFixed(0)+'ms');\n
