x0d\n    throw new ERR_INVALID_URL_SCHEME('file');\x0d\n  }\x0d\n  return (windows ?? isWindows) ? getPathBufferFromURLWin32(path) : getPathBufferFromURLPosix(path);\x0d\n}\x0d\n\x0d\nfunction pathToFileURL(filepath\x2C options = kEmptyObject) {\x0d\n  const windows = options?.windows ?? isWindows;\x0d\n  const isUNC = windows && StringPrototypeStartsWith(filepath\x2C '\\\\\\\\');\x0d\n  let resolved = isUNC ?\x0d\n    filepath :\x0d\n    (windows ? path.win32.resolve(filepath) : path.posix.resolve(filepath));\x0d\n  if (isUNC || (windows && StringPrototypeStartsWith(resolved\x2C '\\\\\\\\'))) {\x0d\n    // UNC path format: \\\\server\\share\\resource\x0d\n    // Handle extended UNC path and standard UNC path\x0d\n    // "\\\\?\\UNC\\" path prefix should be ignored.\x0d\n    // Ref: https://learn.microsoft.com/en-us/windows/win32/fileio/maximum-file-path-limitation\x0d\n    const isExtendedUNC = StringPrototypeStartsWith(resolved\x2C '\\\\\\\\?\\\\UNC\\\\');\x0d\n    const prefixLength = isExtendedUNC ? 8 : 2;\x0d\n    const hostnameEndIndex = StringPrototypeIndexOf(resolved\x2C '\\\\'\x2C prefixLength);\x0d\n    if (hostnameEndIndex === -1) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        'path'\x2C\x0d\n        resolved\x2C\x0d\n        'Missing UNC resource path'\x2C\x0d\n      );\x0d\n    }\x0d\n    if (hostnameEndIndex === 2) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        'path'\x2C\x0d\n        resolved\x2C\x0d\n        'Empty UNC servername'\x2C\x0d\n      );\x0d\n    }\x0d\n    const hostname = StringPrototypeSlice(resolved\x2C prefixLength\x2C hostnameEndIndex);\x0d\n    return new URL(StringPrototypeSlice(resolved\x2C hostnameEndIndex)\x2C hostname\x2C kCreateURLFromWindowsPathSymbol);\x0d\n  }\x0d\n  // path.resolve strips trailing slashes so we must add them back\x0d\n  const filePathLast = StringPrototypeCharCodeAt(filepath\x2C\x0d\n                                                 filepath.length - 1);\x0d\n  if ((filePathLast === CHAR_FORWARD_SLASH ||\x0d\n       ((windows ?? isWindows) && filePathLast === CHAR_BACKWARD_SLASH)) &&\x0d\n      resolved[resolved.length - 1] !== path.sep)\x0d\n    resolved += '/';\x0d\n\x0d\n  return new URL(resolved\x2C undefined\x2C windows ? kCreateURLFromWindowsPathSymbol : kCreateURLFromPosixPathSymbol);\x0d\n}\x0d\n\x0d\nfunction toPathIfFileURL(fileURLOrPath) {\x0d\n  if (!isURL(fileURLOrPath))\x0d\n    return fileURLOrPath;\x0d\n  return fileURLToPath(fileURLOrPath);\x0d\n}\x0d\n\x0d\n/**\x0d\n * This util takes a string containing a URL and return the URL origin\x2C\x0d\n * its meant to avoid calls to `new URL` constructor.\x0d\n * @param {string} url\x0d\n * @returns {URL['origin']}\x0d\n */\x0d\nfunction getURLOrigin(url) {\x0d\n  return bindingUrl.getOrigin(url);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  fileURLToPath\x2C\x0d\n  fileURLToPathBuffer\x2C\x0d\n  pathToFileURL\x2C\x0d\n  toPathIfFileURL\x2C\x0d\n  installObjectURLMethods\x2C\x0d\n  URL\x2C\x0d\n  URLSearchParams\x2C\x0d\n  URLParse: URL.parse\x2C\x0d\n  domainToASCII\x2C\x0d\n  domainToUnicode\x2C\x0d\n  urlToHttpOptions\x2C\x0d\n  encodeStr\x2C\x0d\n  isURL\x2C\x0d\n\x0d\n  urlUpdateActions: updateActions\x2C\x0d\n  getURLOrigin\x2C\x0d\n  unsafeProtocol\x2C\x0d\n  hostlessProtocol\x2C\x0d\n  slashedProtocol\x2C\x0d\n};\x0d\n
