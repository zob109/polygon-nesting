script-source,81,C:\\Users\\Admin\\AppData\\Local\\Programs\\WorkBuddy\\resources\\app.asar.unpacked\\cli\\vendor\\sandbox-center-runtime-kit\\shim\\node-safe-delete-shim.cjs,/**\n * CodeBuddy Node safe-delete shim\n *\n * Loaded by node-language-shim.cjs. Installs only delete-protection hooks.\n */\n\n'use strict';\n\nconst fs = require('fs');\nconst path = require('path');\nconst os = require('os');\nconst url = require('url');\nconst { execFileSync } = require('child_process');\nconst openReportFileSync = fs.openSync.bind(fs);\nconst writeReportFileSync = fs.writeSync.bind(fs);\nconst closeReportFileSync = fs.closeSync.bind(fs);\n\nconst SESSION_ID = process.env.CODEBUDDY_SESSION_ID\n    || process.env.CLAUDE_SESSION_ID;\n\nif (!SESSION_ID) {\n    return;\n}\n\nconst SAFE_DELETE_ENABLED = process.env.CODEBUDDY_SAFE_DELETE_ENABLED !== '0';\n\nif (!SAFE_DELETE_ENABLED) {\n    return;\n}\n\nif (global.__CODEBUDDY_NODE_SAFE_DELETE_SHIM_LOADED__) {\n    return;\n}\nglobal.__CODEBUDDY_NODE_SAFE_DELETE_SHIM_LOADED__ = true;\n\nconst PLATFORM = process.platform; // 'darwin' | 'win32' | 'linux' | ...\nconst REPORT_PATH = process.env.CODEBUDDY_SAFE_DELETE_REPORT_PATH;\n\nfunction normalizePathForCompare(filePath) {\n    let resolved = path.resolve(filePath);\n    try {\n        resolved = fs.realpathSync.native ? fs.realpathSync.native(resolved) : fs.realpathSync(resolved);\n    } catch (_) {\n        // Non-existent paths still need stable comparison for native error passthrough.\n    }\n    return PLATFORM === 'win32' ? resolved.toLowerCase() : resolved;\n}\n\nfunction loadBulkReplayPaths() {\n    const replayFile = process.env.CODEBUDDY_SAFE_DELETE_BULK_REPLAY_FILE;\n    if (!replayFile) return new Set();\n    try {\n        const paths = JSON.parse(fs.readFileSync(replayFile\x2C 'utf8'));\n        return new Set(Array.isArray(paths)\n            ? paths.filter(item => typeof item === 'string').map(normalizePathForCompare)\n            : []);\n    } catch (_) {\n        return new Set();\n    }\n}\n\nconst BULK_REPLAY_PATHS = loadBulkReplayPaths();\n\nfunction wasDeletedBeforeBulkReplay(absPath) {\n    return BULK_REPLAY_PATHS.has(normalizePathForCompare(absPath));\n}\n\nfunction isUsableTempRoot(filePath) {\n    try {\n        const resolved = path.resolve(filePath);\n        if (path.parse(resolved).root === resolved) return false;\n        return fs.statSync(resolved).isDirectory();\n    } catch (_) {\n        return false;\n    }\n}\n\nfunction buildOsTmpDirs() {\n    const candidates = [\n        os.tmpdir()\x2C\n    ];\n    if (PLATFORM !== 'win32') {\n        candidates.push('/tmp');\n        candidates.push('/private/tmp');\n    }\n\n    const roots = [];\n    const seen = new Set();\n    for (const candidate of candidates) {\n        if (!candidate || !isUsableTempRoot(candidate)) continue;\n        const root = normalizePathForCompare(candidate);\n        if (seen.has(root)) continue;\n        seen.add(root);\n        roots.push(root);\n    }\n    return roots;\n}\n\nconst OS_TMP_DIRS = buildOsTmpDirs();\n\nfunction isUnderAnyTempDir(absPath\x2C roots) {\n    const target = normalizePathForCompare(absPath);\n    return roots.some(root => {\n        const rel = path.relative(root\x2C target);\n        return !!rel && rel !== '..' && !rel.startsWith(`..${path.sep}`) && !path.isAbsolute(rel);\n    });\n}\n\nfunction buildNpmCacheTmpDirs() {\n    const candidates = [];\n    const configuredCache = process.env.npm_config_cache || process.env.NPM_CONFIG_CACHE;\n    if (configuredCache) {\n        candidates.push(path.join(configuredCache\x2C '_cacache'\x2C 'tmp'));\n    }\n\n    if (PLATFORM === 'win32') {\n        const localAppData = process.env.LOCALAPPDATA;\n        if (localAppData) candidates.push(path.join(localAppData\x2C 'npm-cache'\x2C '_cacache'\x2C 'tmp'));\n    } else {\n        const homeDir = os.homedir();\n        if (homeDir) candidates.push(path.join(homeDir\x2C '.npm'\x2C '_cacache'\x2C 'tmp'));\n    }\n\n    const roots = [];\n    const seen = new Set();\n    for (const candidate of candidates) {\n        if (!candidate || !isUsableTempRoot(candidate)) continue;\n        const root = normalizePathForCompare(candidate);\n        if (seen.has(root)) continue;\n        seen.add(root);\n        roots.push(root);\n    }\n    return roots;\n}\n\nconst NPM_CACHE_TMP_DIRS = buildNpmCacheTmpDirs();\nconst WORKBUDDY_CONFIG_DIRS = [\n    process.env.WORKBUDDY_CONFIG_DIR\x2C\n    process.env.CODEBUDDY_CONFIG_DIR\x2C\n].filter(candidate => candidate && candidate.trim())\n    .map(candidate => normalizePathForCompare(candidate.trim()));\nconst NPM_CACHE_LOG_DIRS = [\n    PLATFORM === 'win32' && process.env.LOCALAPPDATA\n        ? path.join(process.env.LOCALAPPDATA\x2C 'npm-cache'\x2C '_logs')\n        : null\x2C\n    PLATFORM !== 'win32' && os.homedir()\n        ? path.join(os.homedir()\x2C '.npm'\x2C '_logs')\n        : null\x2C\n    ...WORKBUDDY_CONFIG_DIRS.map(configDir =>\n        path.join(configDir\x2C 'binaries'\x2C 'node'\x2C 'cli-connector-cache'\x2C '_logs')\n    )\x2C\n].filter(Boolean).map(root => normalizePathForCompare(root));\n\nfunction isNpmCacheLogFile(absPath) {\n    const target = normalizePathForCompare(absPath);\n    const baseName = path.basename(target);\n    if (!baseName.toLowerCase().endsWith('.log')) return false;\n    const parent = normalizePathForCompare(path.dirname(target));\n    return NPM_CACHE_LOG_DIRS.includes(parent);\n}\n\nfunction isManagedNodeStagingName(name) {\n    const match = name.match(/^\\.[^/\\\\]+-([A-Za-z0-9_-]{6\x2C})$/);\n    return !!match && /[A-Za-z]/.test(match[1]) && /\\d/.test(match[1]);\n}\n\nfunction isManagedNodeStagingRoot(parts\x2C nodeModulesIndex) {\n    if (parts[nodeModulesIndex] !== 'node_modules') return false;\n    const stagingName = parts[nodeModulesIndex + 1];\n    if (!stagingName || !isManagedNodeStagingName(stagingName)) return false;\n    return (parts[2] === 'versions' && nodeModulesIndex === 4)\n        || (parts[2] === 'cli-connector-packages' && nodeModulesIndex >= 3);\n}\n\nfunction isWorkBuddyManagedNodeInstallStagingPath(absPath) {\n    const target = normalizePathForCompare(absPath);\n    return WORKBUDDY_CONFIG_DIRS.some(configDir => {\n        const rel = path.relative(configDir\x2C target);\n        if (!rel || rel === '..' || rel.startsWith(`..${path.sep}`) || path.isAbsolute(rel)) {\n            return false;\n        }\n\n        const parts = rel.split(path.sep).filter(Boolean);\n        if (parts[0] !== 'binaries' || parts[1] !== 'node') return false;\n        return parts.some((part\x2C index) => part === 'node_modules' && isManagedNodeStagingRoot(parts\x2C index));\n    });\n}\n\nfunction isPnpmVirtualStorePath(absPath) {\n    const parts = normalizePathForCompare(absPath).split(path.sep).filter(Boolean);\n    return parts.some((part\x2C index) => index > 0 && part === '.pnpm' && parts[index - 1] === 'node_modules');\n}\n\nfunction shouldBypassSafeDelete(absPath) {\n    return isUnderAnyTempDir(absPath\x2C OS_TMP_DIRS)\n        || isUnderAnyTempDir(absPath\x2C NPM_CACHE_TMP_DIRS)\n        || isNpmCacheLogFile(absPath)\n        || isWorkBuddyManagedNodeInstallStagingPath(absPath)\n        || isPnpmVirtualStorePath(absPath);\n}\n\nfunction recordReport(operation\x2C absPath) {\n    if (!REPORT_PATH) return;\n    let fd;\n    try {\n        fd = openReportFileSync(REPORT_PATH\x2C 'a');\n        writeReportFileSync(\n            fd\x2C\n            `${JSON.stringify({\n                operation\x2C\n                runtime: 'node'\x2C\n                path: absPath\x2C\n                timestamp: Date.now()\x2C\n            })}\\n`\x2C\n            null\x2C\n            'utf8'\x2C\n        );\n    } catch (_) {\n        // Reporting is best-effort and must never change delete semantics.\n    } finally {\n        if (fd !== undefined) {\n            try { closeReportFileSync(fd); } catch (_) { /* ignore */ }\n        }\n    }\n}\n\nfunction checkBulkDeleteGuard(absPath) {\n    const guardPath = process.env.CODEBUDDY_SAFE_DELETE_BULK_GUARD;\n    const nodeBin = process.env.CODEBUDDY_NODE_BIN;\n    if (!process.env.CODEBUDDY_SAFE_DELETE_BULK_STATE_DIR || !process.env.CODEBUDDY_TOOL_CALL_ID) {\n        return;\n    }\n    if (!guardPath || !nodeBin || !fs.existsSync(guardPath)) {\n        throw new Error(`[safe-delete][SAFE_DELETE_BULK_GUARD_ERROR] msg=helper-unavailable guard=${guardPath || 'unset'}`);\n    }\n    const helperEnv = { ...process.env };\n    delete helperEnv.NODE_OPTIONS;\n    if (helperEnv.CODEBUDDY_NODE_RUN_AS_NODE === '1') {\n        helperEnv.ELECTRON_RUN_AS_NODE = '1';\n    }\n    try {\n        execFileSync(nodeBin\x2C [guardPath\x2C 'check'\x2C '--target'\x2C absPath]\x2C {\n            stdio: ['ignore'\x2C 'ignore'\x2C 'pipe']\x2C\n            timeout: 10_000\x2C\n            windowsHide: true\x2C\n            env: helperEnv\x2C\n        });\n    } catch (e) {\n        const detail = e && e.stderr ? String(e.stderr).trim() : '';\n        if (detail) {\n            throw new Error(detail);\n        }\n        throw new Error(`[safe-delete][SAFE_DELETE_BULK_GUARD_ERROR] ${(e && e.message) || String(e)}`);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// \u5e73\u53f0\u5206\u53d1\n// ---------------------------------------------------------------------------\n\n// ---- \u89e3\u6790 genie-trash binary \u8def\u5f84 ----\n// \u4f18\u5148\u4f7f\u7528 GENIE_TRASH_DIR \u73af\u5883\u53d8\u91cf\uff08\u7531 buildSafeDeleteEnv() \u6ce8\u5165\uff09\uff0c\n// \u89e3\u51b3\u6253\u5305\u540e extraResources\uff08<Resources>/vendor/genie-trash/\uff09\u4e0e\n// shim\uff08app.asar.unpacked/cli/vendor/shim/\uff09\u4e0d\u5171\u7236\u76ee\u5f55\u7684\u8def\u5f84\u9519\u4f4d\u95ee\u9898\u3002\n// \u5f00\u53d1\u73af\u5883 fallback: ../genie-trash/ \u76f8\u5bf9 __dirname\nfunction resolveTrashBin() {\n    const ext = PLATFORM === 'win32' ? '.exe' : '';\n    const fileName = `${PLATFORM}-${process.arch}${ext}`;\n    if (process.env.GENIE_TRASH_DIR) {\n        return path.join(process.env.GENIE_TRASH_DIR\x2C fileName);\n    }\n    return path.resolve(__dirname\x2C '..'\x2C 'genie-trash'\x2C fileName);\n}\n\n// ---- \u5c1d\u8bd5 native binary\uff0c\u4e0d\u53ef\u7528\u5219\u964d\u7ea7 ----\nlet _trashBinAvailable = null; // null=\u672a\u63a2\u6d4b\x2C true=\u53ef\u7528\x2C false=\u4e0d\u53ef\u7528\n\nfunction trashViaBinary(absPath) {\n    if (_trashBinAvailable === false) return false; // \u5df2\u77e5\u4e0d\u53ef\u7528\uff0c\u5feb\u901f\u77ed\u8def\n    const existed = pathStillExists(absPath);\n    try {\n        execFileSync(resolveTrashBin()\x2C [absPath]\x2C {\n            stdio: ['ignore'\x2C 'pipe'\x2C 'pipe']\x2C\n            timeout: 5_000\x2C\n        });\n        _trashBinAvailable = true;\n        return true;\n    } catch (e) {\n        // ENOENT\uff1abinary \u4e0d\u5b58\u5728\uff0c\u8fdb\u7a0b\u751f\u547d\u5468\u671f\u5185\u4e0d\u4f1a\u51ed\u7a7a\u51fa\u73b0\uff0c\u7f13\u5b58\u7981\u7528\n        if (e.code === 'ENOENT') {\n            _trashBinAvailable = false;\n            return false;\n        }\n        // EACCES\uff1a\u6743\u9650\u95ee\u9898\u53ef\u80fd\u662f\u4e34\u65f6\u72b6\u6001\uff08\u5982 chmod +x \u540e\u6062\u590d\uff09\uff0c\u4e0d\u7f13\u5b58\n        if (e.code === 'EACCES') {\n            return false;\n        }\n        // Windows \u4e0a trash crate \u7684 IFileOperation::GetAnyOperationsAborted \u4f1a\u8bef\u62a5 true\uff0c\n        // \u4f46 PerformOperations \u5b9e\u9645\u5df2\u5220\u9664\u6587\u4ef6\u3002\u4ee5\u6587\u4ef6\u7cfb\u7edf\u4e8b\u5b9e\u4e3a\u51c6\uff1a\u8c03\u7528\u524d\u5728\u3001\u8c03\u7528\u540e\u6ca1\u4e86 = \u5220\u9664\u6210\u529f\u3002\n        // \u4ec5 Windows \u542f\u7528\uff1a\u6839\u56e0\u662f Win32 \u72ec\u6709 API\uff0c\u975e Windows \u4e0a\u5931\u8d25\u539f\u56e0\u672a\u77e5\uff0c\u4e0d\u5e94\u9759\u9ed8\u541e\u6389\u3002\n        // \u53c2\u8003 https://github.com/maxkagamine/wsl-tools \u7684 recycle_bin.rs\n        if (PLATFORM === 'win32' && existed && !pathStillExists(absPath)) {\n            _trashBinAvailable = true;\n            return true;\n        }\n        // binary \u5df2\u542f\u52a8\u4f46\u5bf9\u8be5\u8def\u5f84\u64cd\u4f5c\u5931\u8d25\uff08exit code 1\uff09\u6216\u8d85\u65f6\u2014\u2014\u5411\u4e0a\u629b\uff0c\u4e0d\u771f\u5220\n        const detail = e.stderr ? e.stderr.toString().trim() : '';\n        throw new Error(`[safe-delete] \u64cd\u4f5c\u5931\u8d25: ${detail || e.message}`);\n    }\n}\n\n/**\n * \u628a\u6587\u4ef6/\u76ee\u5f55\u79fb\u5165\u7cfb\u7edf\u56de\u6536\u7ad9\u3002\n * \u4f18\u5148 native binary\uff08\u6027\u80fd\u6700\u4f18\uff09\uff0c\u4e0d\u53ef\u7528\u65f6\u81ea\u52a8\u964d\u7ea7\u5230\u5e73\u53f0\u5b9e\u73b0\u3002\n * \u540c\u6b65\u8c03\u7528\uff0c\u5931\u8d25\u629b\u9519\uff08fail-closed\uff0c\u8c03\u7528\u65b9\u4e0d\u5f97\u771f\u5220\uff09\u3002\n *\n * @param {string} absPath \u7edd\u5bf9\u8def\u5f84\n */\nfunction trashItem(absPath) {\n    // \u4f18\u5148 native binary\n    if (trashViaBinary(absPath)) return;\n\n    // ---- \u964d\u7ea7\uff1a\u5f53\u524d\u5e73\u53f0\u5b9e\u73b0\uff08\u5168\u90e8\u4fdd\u7559\uff09 ----\n    if (PLATFORM === 'darwin') {\n        return trashOnMac(absPath);\n    }\n    if (PLATFORM === 'win32') {\n        return trashOnWindows(absPath);\n    }\n    // linux / freebsd / \u5176\u5b83 POSIX\n    return trashOnFreedesktop(absPath);\n}\n\n// ----- macOS -----\n\nconst DARWIN_TRASH_PYTHON_SCRIPT = `\nimport os\nimport sys\nfrom ctypes import Structure\x2C byref\x2C c_char\x2C c_char_p\x2C cdll\nfrom ctypes.util import find_library\n\npath = sys.argv[1]\nfoundation_path = find_library("Foundation")\ncoreservices_path = find_library("CoreServices")\nif not foundation_path or not coreservices_path:\n    print("Foundation/CoreServices unavailable"\x2C file=sys.stderr)\n    sys.exit(1)\n\nFoundation = cdll.LoadLibrary(foundation_path)\nCoreServices = cdll.LoadLibrary(coreservices_path)\nGetMacOSStatusCommentString = Foundation.GetMacOSStatusCommentString\nGetMacOSStatusCommentString.restype = c_char_p\nFSPathMakeRefWithOptions = CoreServices.FSPathMakeRefWithOptions\nFSMoveObjectToTrashSync = CoreServices.FSMoveObjectToTrashSync\n\nclass FSRef(Structure):\n    _fields_ = [("hidden"\x2C c_char * 80)]\n\ndef status_to_message(code: int) -> str:\n    raw = GetMacOSStatusCommentString(code)\n    if not raw:\n        return f"OSStatus {code}"\n    return raw.decode("utf-8"\x2C errors="replace")\n\npath_b = os.fsencode(path)\nfp = FSRef()\nrc = FSPathMakeRefWithOptions(path_b\x2C 0x01\x2C byref(fp)\x2C None)\nif rc:\n    print(status_to_message(rc)\x2C file=sys.stderr)\n    sys.exit(1)\n\nrc = FSMoveObjectToTrashSync(byref(fp)\x2C None\x2C 0)\nif rc:\n    print(status_to_message(rc)\x2C file=sys.stderr)\n    sys.exit(1)\n`.trim();\n\nfunction pathStillExists(absPath) {\n    if (fs.existsSync(absPath)) {\n        return true;\n    }\n    try {\n        // existsSync \u5bf9 dangling symlink \u8fd4\u56de false\uff0clstat \u53ef\u8bc6\u522b\u8be5\u573a\u666f\u3002\n        fs.lstatSync(absPath);\n        return true;\n    } catch (_) {\n        return false;\n    }\n}\n\nfunction trashOnMac(absPath) {\n    execFileSync('python3'\x2C ['-'\x2C absPath]\x2C {\n        input: DARWIN_TRASH_PYTHON_SCRIPT\x2C\n        stdio: ['pipe'\x2C 'ignore'\x2C 'pipe']\x2C\n        timeout: 10_000\x2C\n    });\n    // API \u8c03\u7528\u6210\u529f\u540e\u8ffd\u52a0\u5b58\u5728\u6027\u6821\u9a8c\uff1a\u8def\u5f84\u4ecd\u5728\u539f\u5904\u89c6\u4e3a\u5931\u8d25\uff08fail-closed\uff09\u3002\n    if (pathStillExists(absPath)) {\n        throw new Error('File still exists after python ctypes trash command');\n    }\n}\n\n// ----- Windows -----\n\nfunction trashOnWindows(absPath) {\n    // \u7528 Microsoft.VisualBasic.FileIO.FileSystem \u7684 SendToRecycleBin \u9009\u9879\n    // \u5b83\u5bf9\u6587\u4ef6\u548c\u76ee\u5f55\u6709\u4e0d\u540c\u7684 API\uff1aDeleteFile / DeleteDirectory\n    const stat = fs.lstatSync(absPath);\n    const method = stat.isDirectory() ? 'DeleteDirectory' : 'DeleteFile';\n    // \u8def\u5f84\u4e2d\u7684\u5355\u5f15\u53f7\u9700\u53cc\u5199\uff08PowerShell \u5355\u5f15\u53f7\u5b57\u7b26\u4e32\uff09\n    const escaped = absPath.replace(/'/g\x2C "''");\n    const script = [\n        '$ErrorActionPreference = "Stop"'\x2C\n        'Add-Type -AssemblyName Microsoft.VisualBasic'\x2C\n        `[Microsoft.VisualBasic.FileIO.FileSystem]::${method}('${escaped}'\x2C`\n            + ' [Microsoft.VisualBasic.FileIO.UIOption]::OnlyErrorDialogs\x2C'\n            + ' [Microsoft.VisualBasic.FileIO.RecycleOption]::SendToRecycleBin)'\x2C\n    ].join('; ');\n    execFileSync('powershell'\x2C ['-NoProfile'\x2C '-NonInteractive'\x2C '-Command'\x2C script]\x2C {\n        stdio: ['ignore'\x2C 'ignore'\x2C 'pipe']\x2C\n        timeout: 15_000\x2C\n        windowsHide: true\x2C\n    });\n}\n\n// ----- Linux freedesktop -----\n\nconst HOME = os.homedir();\nconst XDG_DATA_HOME = process.env.XDG_DATA_HOME || path.join(HOME\x2C '.local'\x2C 'share');\nconst TRASH_FILES = path.join(XDG_DATA_HOME\x2C 'Trash'\x2C 'files');\nconst TRASH_INFO = path.join(XDG_DATA_HOME\x2C 'Trash'\x2C 'info');\n\nlet _dirsEnsured = false;\n\nfunction trashOnFreedesktop(absPath) {\n    // freedesktop spec \u8981\u6c42 trash \u76ee\u5f55\u6743\u9650 0700\n    if (!_dirsEnsured) {\n        fs.mkdirSync(TRASH_FILES\x2C { recursive: true\x2C mode: 0o700 });\n        fs.mkdirSync(TRASH_INFO\x2C { recursive: true\x2C mode: 0o700 });\n        _dirsEnsured = true;\n    }\n\n    const baseName = path.basename(absPath);\n    // writeTrashInfo \u5185\u90e8\u4f7f\u7528\u539f\u5b50 wx \u5199\u5165 + EEXIST \u91cd\u8bd5\uff0c\u6d88\u9664 TOCTOU \u7a97\u53e3\n    const { destFiles\x2C destInfo } = writeTrashInfo(absPath\x2C baseName);\n\n    try {\n        fs.renameSync(absPath\x2C destFiles);\n    } catch (e) {\n        if (e.code === 'EXDEV') {\n            // \u8de8\u8bbe\u5907\uff1acopy + delete \u56de\u9000\uff08\u53c2\u7167 Python send2trash \u7684 shutil.move \u56de\u9000\uff09\n            try {\n                const st = fs.lstatSync(absPath);\n                if (st.isDirectory()) {\n                    copyRecursiveSync(absPath\x2C destFiles);\n                    origRmSync\n                        ? origRmSync(absPath\x2C { recursive: true\x2C force: true })\n                        : removeRecursiveSync(absPath);\n                } else {\n                    fs.copyFileSync(absPath\x2C destFiles);\n                    origUnlinkSync(absPath);\n                }\n                return;\n            } catch (copyErr) {\n                // copy \u4e5f\u5931\u8d25 / \u6e90\u5220\u9664\u5931\u8d25 \u2192 \u6e05\u7406 trashinfo \u548c\u5df2\u590d\u5236\u5230 trash \u7684\u6587\u4ef6\n                try { origUnlinkSync(destInfo); } catch (_) { /* ignore */ }\n                try {\n                    if (fs.existsSync(destFiles)) {\n                        origRmSync\n                            ? origRmSync(destFiles\x2C { recursive: true\x2C force: true })\n                            : removeRecursiveSync(destFiles);\n                    }\n                } catch (_) { /* ignore */ }\n                throw copyErr;\n            }\n        }\n        // \u5176\u4ed6\u9519\u8bef\uff08\u6743\u9650\u4e0d\u8db3\u7b49\uff09\u2192 \u6e05\u7406 trashinfo\uff0c\u5411\u4e0a\u629b\n        try { origUnlinkSync(destInfo); } catch (_) { /* ignore */ }\n        throw e;\n    }\n}\n\n/**\n * \u9012\u5f52\u5220\u9664\u76ee\u5f55\uff08origRmSync \u4e0d\u53ef\u7528\u65f6\u7684\u56de\u9000\uff09\u3002\n */\nfunction removeRecursiveSync(dirPath) {\n    const entries = fs.readdirSync(dirPath\x2C { withFileTypes: true });\n    for (const entry of entries) {\n        const full = path.join(dirPath\x2C entry.name);\n        if (entry.isDirectory()) {\n            removeRecursiveSync(full);\n        } else {\n            origUnlinkSync(full);\n        }\n    }\n    origRmdirSync(dirPath);\n}\n\n/**\n * \u9012\u5f52\u590d\u5236\u76ee\u5f55\uff08fs.cpSync \u4e0d\u53ef\u7528\u65f6\u7684\u56de\u9000\uff0cNode < 16.7\uff09\u3002\n */\nfunction copyRecursiveSync(src\x2C dest) {\n    if (fs.cpSync) {\n        fs.cpSync(src\x2C dest\x2C { recursive: true });\n        return;\n    }\n    fs.mkdirSync(dest\x2C { recursive: true });\n    const entries = fs.readdirSync(src\x2C { withFileTypes: true });\n    for (const entry of entries) {\n        const srcFull = path.join(src\x2C entry.name);\n        const destFull = path.join(dest\x2C entry.name);\n        if (entry.isDirectory()) {\n            copyRecursiveSync(srcFull\x2C destFull);\n        } else {\n            fs.copyFileSync(srcFull\x2C destFull);\n        }\n    }\n}\n\n/**\n * \u5199\u5165 .trashinfo \u6587\u4ef6\u5e76\u8fd4\u56de dest \u8def\u5f84\u3002\n *\n * \u4f7f\u7528\u539f\u5b50 writeFileSync('wx') + EEXIST \u91cd\u8bd5\uff0c\u7f29\u5c0f existsSync\u2192write \u4e4b\u95f4\u7684\n * TOCTOU \u7a97\u53e3\uff08\u53e6\u4e00\u8fdb\u7a0b\u5728\u68c0\u67e5\u4e0e\u5199\u5165\u4e4b\u95f4\u521b\u5efa\u540c\u540d\u6587\u4ef6\u65f6\u53ef\u91cd\u8bd5\uff09\u3002\n *\n * \u547d\u540d\u7b56\u7565: baseName\x2C baseName.2\x2C baseName.3\x2C ...\uff08freedesktop spec \u517c\u5bb9\uff09\n *\n * @param {string} absPath  \u539f\u59cb\u6587\u4ef6\u7edd\u5bf9\u8def\u5f84\uff08\u7528\u4e8e\u5199\u5165 trashinfo \u7684 Path \u5b57\u6bb5\uff09\n * @param {string} baseName \u6587\u4ef6\u540d\uff08\u4e0d\u542b\u76ee\u5f55\uff09\uff0c\u7528\u4e8e\u6784\u9020 trash \u4e2d\u7684\u76ee\u6807\u540d\n * @returns {{ destFiles: string\x2C destInfo: string\x2C trashedName: string }}\n */\nfunction writeTrashInfo(absPath\x2C baseName) {\n    const deletionDate = new Date().toISOString().replace(/\\.\\d{3}Z$/\x2C '');\n    const escapedPath = absPath.split('/').map(s => {\n        return s.replace(/[^\\x20-\\x7E]/g\x2C c => encodeURIComponent(c));\n    }).join('/');\n    const info = `[Trash Info]\\nPath=${escapedPath}\\nDeletionDate=${deletionDate}\\n`;\n\n    let name = baseName;\n    let i = 2;\n    const nextName = () => {\n        name = `${baseName}.${i++}`;\n        if (i > 1000) {\n            throw new Error('Too many trash name conflicts');\n        }\n    };\n    while (true) {\n        const destFiles = path.join(TRASH_FILES\x2C name);\n        const destInfo = path.join(TRASH_INFO\x2C name + '.trashinfo');\n        // \u534a\u6b8b\u7559\u573a\u666f\uff1afiles \u5b58\u5728\u4f46 info \u7f3a\u5931\uff0c\u5fc5\u987b\u907f\u5f00\uff0c\u907f\u514d\u540e\u7eed rename \u8986\u76d6\u65e7\u6587\u4ef6\n        if (fs.existsSync(destFiles)) {\n            nextName();\n            continue;\n        }\n        try {\n            // wx\uff1a\u539f\u5b50\u521b\u5efa\uff0c\u82e5\u6587\u4ef6\u5df2\u5b58\u5728\u629b EEXIST \u2192 \u81ea\u589e\u91cd\u8bd5\n            fs.writeFileSync(destInfo\x2C info\x2C { flag: 'wx'\x2C mode: 0o600 });\n            // \u7ade\u4e89\u7a97\u53e3\uff1a\u82e5\u53e6\u4e00\u8fdb\u7a0b\u5728\u672c\u6b21\u5199\u5165\u540e\u521b\u5efa\u4e86\u540c\u540d files\uff0c\u5220\u9664\u521a\u5199\u5165\u7684 info \u5e76\u91cd\u8bd5\n            if (fs.existsSync(destFiles)) {\n                try { origUnlinkSync(destInfo); } catch (_) { /* ignore */ }\n                nextName();\n                continue;\n            }\n            return { destFiles\x2C destInfo\x2C trashedName: name };\n        } catch (e) {\n            if (e.code === 'EEXIST') {\n                nextName();\n                continue;\n            }\n            throw e;\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// broker IPC delete\uff1a\u4f18\u5148\u8d70 HostFileOperation delete \u2192 host service \u2192 trash\n// ---------------------------------------------------------------------------\n\nfunction tryBrokerDelete(absPath\x2C opts) {\n    let deleteBroker;\n    try {\n        deleteBroker = require('./safe-delete-broker-delete.cjs');\n    } catch (_) {\n        return 'unavailable';\n    }\n    return deleteBroker.tryBrokerDelete(absPath\x2C {\n        runtime: 'node'\x2C\n        recursive: !!(opts && opts.recursive)\x2C\n        force: !!(opts && opts.force)\x2C\n        sync: true\x2C\n        reportTrash: absPath => recordReport('trash'\x2C absPath)\x2C\n    });\n}\n\n// ---------------------------------------------------------------------------\n// \u6838\u5fc3\uff1a\u5c1d\u8bd5\u79fb\u5165\u56de\u6536\u7ad9\u3002broker \u62d2\u7edd\u6216\u56de\u6536\u7ad9\u5931\u8d25\u4e00\u5f8b\u629b\u9519\uff0c\u4e0d\u964d\u7ea7\u771f\u5220\u3002\n// ---------------------------------------------------------------------------\n\n/**\n * \u628a\u6587\u4ef6/\u76ee\u5f55\u79fb\u5165\u7cfb\u7edf\u56de\u6536\u7ad9\u3002\u5931\u8d25\u65f6\u629b\u9519\uff08fail-closed\uff09\uff0c\u4e0d\u964d\u7ea7\u771f\u5220\u3002\n * @param {string} absPath \u7edd\u5bf9\u8def\u5f84\n */\nfunction tryTrash(absPath\x2C opts) {\n    checkBulkDeleteGuard(absPath);\n\n    const brokerResult = tryBrokerDelete(absPath\x2C opts);\n    if (brokerResult === 'ok') {\n        return true;\n    }\n    if (brokerResult === 'denied') {\n        throw new Error(`[safe-delete] broker denied delete: path=${absPath}`);\n    }\n\n    // Windows \u6c99\u7bb1\u4e14\u5f00\u542f\u6587\u4ef6\u5907\u4efd\uff1a\u666e\u901a\u6587\u4ef6\u4ea4\u7ed9 tsbx+Center \u51b3\u5b9a\u662f\u5426\u8fdb\u56de\u6536\u7ad9\uff08\u672c\u8f6e\u65b0\u5efa\u7684\n    // \u76f4\u63a5\u5220\uff09\u3002\u539f\u751f\u5220\u9664\u5931\u8d25\uff08\u5982 Center \u62d2\u7edd\uff09\u65f6\u7ee7\u7eed\u8d70 genie-trash\uff0c\u4fdd\u7559\u5ba1\u6279\u4e0e fail-closed\u3002\n    if (PLATFORM === 'win32'\n        && process.env.CODEBUDDY_SAFE_DELETE_SANDBOX === '1'\n        && process.env.CODEBUDDY_FILE_BACKUP_ENABLED === '1') {\n        const st = safeLstat(absPath);\n        if (st && st.isFile()) {\n            try {\n                origUnlinkSync(absPath);\n                recordReport('native-delete'\x2C absPath);\n                return true;\n            } catch (_) {\n                // \u7ee7\u7eed\u8d70 genie-trash\n            }\n        }\n    }\n\n    trashItem(absPath);\n    recordReport('trash'\x2C absPath);\n    return true;\n}\n\n\n// \u4fdd\u5b58\u539f\u59cb\u5f15\u7528\uff08\u5fc5\u987b\u5728\u6240\u6709 patch \u4e4b\u524d\uff09\nconst origUnlinkSync = fs.unlinkSync.bind(fs);\nconst origRmdirSync = fs.rmdirSync.bind(fs);\nconst origRmSync = fs.rmSync ? fs.rmSync.bind(fs) : null;\n\nconst origUnlink = fs.unlink.bind(fs);\nconst origRmdir = fs.rmdir.bind(fs);\nconst origRm = fs.rm ? fs.rm.bind(fs) : null;\n\nconst origPromisesUnlink = fs.promises ? fs.promises.unlink.bind(fs.promises) : null;\nconst origPromisesRmdir = fs.promises ? fs.promises.rmdir.bind(fs.promises) : null;\nconst origPromisesRm = fs.promises && fs.promises.rm ? fs.promises.rm.bind(fs.promises) : null;\n\n/**\n * \u5c06 fs API \u7684 filePath \u53c2\u6570\u8f6c\u4e3a\u7edd\u5bf9\u8def\u5f84\u3002\n * \u5904\u7406 URL \u5bf9\u8c61\uff08\u5982 new URL('file:///tmp/x')\uff09\uff0c\u907f\u514d String(URL) \u4ea7\u751f\u65e0\u6548\u8def\u5f84\u7ed5\u8fc7 shim\u3002\n * @param {string|Buffer|URL} filePath\n * @returns {string} \u7edd\u5bf9\u8def\u5f84\n */\nfunction toAbsPath(filePath) {\n    if (filePath instanceof URL) {\n        return url.fileURLToPath(filePath);\n    }\n    // \u9632\u5fa1\u8de8 VM context \u7684 URL \u5bf9\u8c61\uff08instanceof \u8de8 realm \u8fd4\u56de false\uff09\n    if (filePath && typeof filePath === 'object' && filePath.href && typeof filePath.protocol === 'string') {\n        return url.fileURLToPath(filePath);\n    }\n    return path.resolve(String(filePath));\n}\n\n\nfunction makeSyncWrapper(orig\x2C requireDir) {\n    return function (filePath\x2C ...rest) {\n        const absPath = toAbsPath(filePath);\n        if (shouldBypassSafeDelete(absPath)) return orig(filePath\x2C ...rest);\n        if (requireDir) {\n            const st = safeLstat(absPath);\n            if (st === null) {\n                if (wasDeletedBeforeBulkReplay(absPath)) return undefined;\n                return orig(filePath\x2C ...rest); // ENOENT \u2192 \u539f\u751f\u629b\n            }\n            if (!st) { /* EACCES/ELOOP\uff1a\u65e0\u6cd5 stat\uff0c\u8df3\u8fc7\u7c7b\u578b\u68c0\u67e5\u76f4\u63a5\u5c1d\u8bd5 trash */ }\n            else {\n                if (!st.isDirectory()) return orig(filePath\x2C ...rest); // ENOTDIR\n                // rmdirSync \u4e0d\u5e26 {recursive: true} \u65f6\uff0c\u975e\u7a7a\u76ee\u5f55\u4ea4\u8fd8\u539f\u751f\u629b ENOTEMPTY\n                // \u5e26 {recursive: true} \u65f6\u8df3\u8fc7 isDirEmpty \u68c0\u67e5\uff0c\u8ba9 tryTrash \u5904\u7406\u6574\u4e2a\u76ee\u5f55\u6811\n                const opts = rest[0];\n                if (!(opts && opts.recursive) && !isDirEmpty(absPath)) return orig(filePath\x2C ...rest);\n            }\n        } else {\n            const st = safeLstat(absPath);\n            if (st === null) {\n                if (wasDeletedBeforeBulkReplay(absPath)) return undefined;\n                return orig(filePath\x2C ...rest); // ENOENT\n            }\n            if (st && st.isDirectory()) return orig(filePath\x2C ...rest); // EISDIR\uff08stat \u6210\u529f + \u662f\u76ee\u5f55\uff09\n        }\n\n        tryTrash(absPath\x2C rest[0] && typeof rest[0] === 'object' ? rest[0] : undefined); // \u5931\u8d25\u65f6\u629b\u9519\uff0c\u4e0d\u8c03 orig\uff08fail-closed\uff09\n        return undefined;\n    };\n}\n\n/**\n * \u5b89\u5168\u7684 lstat\uff1a\u533a\u5206 ENOENT\uff08\u6587\u4ef6\u4e0d\u5b58\u5728\uff09\u548c\u5176\u4ed6\u9519\u8bef\uff08EACCES/ELOOP \u7b49\uff09\u3002\n * @returns {object|null|undefined}\n *   Stats \u5bf9\u8c61 \u2014 \u6210\u529f\n *   null \u2014 \u6587\u4ef6\u4e0d\u5b58\u5728 (ENOENT)\n *   undefined \u2014 \u65e0\u6cd5\u83b7\u53d6\u72b6\u6001\uff08EACCES/ELOOP \u7b49\uff09\uff0c\u8c03\u7528\u65b9\u5e94\u56de\u9000\u539f\u751f\n */\nfunction safeLstat(absPath) {\n    try { return fs.lstatSync(absPath); } catch (e) {\n        if (e.code === 'ENOENT') return null;\n        return undefined;\n    }\n}\n\nfunction isDirEmpty(absPath) {\n    try { return fs.readdirSync(absPath).length === 0; } catch (_) { return false; }\n}\n\nfunction makeCallbackWrapper(orig\x2C requireDir) {\n    return function (filePath\x2C ...rest) {\n        const cb = rest[rest.length - 1];\n        // \u4fdd\u6301 Node callback API \u53c2\u6570\u6821\u9a8c\u8bed\u4e49\uff1a\n        // callback \u7f3a\u5931/\u975e\u51fd\u6570\u65f6\u4ea4\u8fd8\u539f\u751f\u629b ERR_INVALID_ARG_TYPE\uff0c\n        // \u4e0d\u5e94\u5728\u53c2\u6570\u975e\u6cd5\u65f6\u89e6\u53d1 safe-delete\u3002\n        if (typeof cb !== 'function') {\n            return orig(filePath\x2C ...rest);\n        }\n        const absPath = toAbsPath(filePath);\n        if (shouldBypassSafeDelete(absPath)) return orig(filePath\x2C ...rest);\n\n        const st = safeLstat(absPath);\n        if (st === null) {\n            if (wasDeletedBeforeBulkReplay(absPath)) return process.nextTick(() => cb(null));\n            return orig(filePath\x2C ...rest); // ENOENT \u2192 \u539f\u751f\u629b\n        }\n        if (st) {\n            if (requireDir && !st.isDirectory()) return orig(filePath\x2C ...rest);\n            if (!requireDir && st.isDirectory()) return orig(filePath\x2C ...rest);\n        }\n        // rmdir \u4e0d\u5e26 {recursive: true} \u65f6\uff0c\u975e\u7a7a\u76ee\u5f55\u4ea4\u8fd8\u539f\u751f\u629b ENOTEMPTY\n        // rest \u53ef\u80fd\u662f [callback] \u6216 [options\x2C callback]\n        const opts = rest[0] && typeof rest[0] === 'object' ? rest[0] : null;\n        if (requireDir && st && !(opts && opts.recursive) && !isDirEmpty(absPath)) return orig(filePath\x2C ...rest);\n\n        try {\n            tryTrash(absPath\x2C opts || undefined);\n        } catch (e) {\n            if (typeof cb === 'function') {\n                process.nextTick(() => cb(e));\n                return;\n            }\n            throw e;\n        }\n        if (typeof cb === 'function') process.nextTick(() => cb(null));\n    };\n}\n\nfunction makePromiseWrapper(orig\x2C requireDir) {\n    return async function (filePath\x2C ...rest) {\n        const absPath = toAbsPath(filePath);\n        if (shouldBypassSafeDelete(absPath)) return orig(filePath\x2C ...rest);\n        const st = safeLstat(absPath);\n        if (st === null) {\n            if (wasDeletedBeforeBulkReplay(absPath)) return undefined;\n            return orig(filePath\x2C ...rest); // ENOENT \u2192 \u539f\u751f\u629b\n        }\n        if (st) {\n            if (requireDir && !st.isDirectory()) return orig(filePath\x2C ...rest);\n            if (!requireDir && st.isDirectory()) return orig(filePath\x2C ...rest);\n        }\n        // rmdir \u4e0d\u5e26 {recursive: true} \u65f6\uff0c\u975e\u7a7a\u76ee\u5f55\u4ea4\u8fd8\u539f\u751f\u629b ENOTEMPTY\n        const opts = rest[0] || null;\n        if (requireDir && st && !(opts && opts.recursive) && !isDirEmpty(absPath)) return orig(filePath\x2C ...rest);\n\n        tryTrash(absPath\x2C opts || undefined); // \u5931\u8d25\u629b\u9519 \u2192 async \u51fd\u6570\u81ea\u52a8\u8f6c rejected Promise\uff08fail-closed\uff09\n        return undefined;\n    };\n}\n\n// ----- rm / rmSync / promises.rm\uff08\u652f\u6301 recursive / force\uff09-----\n\n/**\n * @returns {{ done: boolean }}\n *   done=true  \u2192 \u5df2\u79fb\u5165\u56de\u6536\u7ad9\uff0c\u8c03\u7528\u65b9\u8fd4\u56de\u6210\u529f\n *   done=false \u2192 \u524d\u7f6e\u6761\u4ef6\u4e0d\u6ee1\u8db3\uff08ENOENT / stat \u9519\u8bef / \u975e recursive \u5220\u76ee\u5f55\uff09\uff0c\u8c03\u7528\u65b9\u8d70\u539f\u751f\n *   throws     \u2192 \u56de\u6536\u7ad9\u64cd\u4f5c\u5931\u8d25\uff08fail-closed\uff09\uff0c\u8c03\u7528\u65b9\u4e0d\u5f97\u771f\u5220\n */\nfunction tryRm(absPath\x2C opts) {\n    if (shouldBypassSafeDelete(absPath)) {\n        return { done: false };\n    }\n\n    const recursive = !!(opts && opts.recursive);\n    const force = !!(opts && opts.force);\n\n    const st = safeLstat(absPath);\n    // st === null\uff1a\u6587\u4ef6\u4e0d\u5b58\u5728 (ENOENT)\n    if (st === null) {\n        if (wasDeletedBeforeBulkReplay(absPath)) return { done: true };\n        if (force) return { done: true }; // force + \u4e0d\u5b58\u5728 = \u9759\u9ed8\u6210\u529f\n        return { done: false }; // \u8ba9\u539f\u751f\u629b ENOENT\n    }\n    // st === undefined\uff1aEACCES/ELOOP \u7b49 stat \u9519\u8bef \u2192 \u4ecd\u5c1d\u8bd5\u79fb\u5165\u56de\u6536\u7ad9\n    // \u4e0d\u964d\u7ea7\u771f\u5220\uff1a\u6587\u4ef6\u53ef\u80fd\u53ef\u901a\u8fc7 trash \u8def\u5f84\u5904\u7406\uff08\u5982\u6743\u9650\u5141\u8bb8 rename \u4f46\u4e0d\u5141\u8bb8 lstat\uff09\uff0c\n    // \u82e5 trash \u4e5f\u5931\u8d25\u5219\u629b\u9519\uff08fail-closed\uff09\uff0c\u4e0e makeSyncWrapper / makeCallbackWrapper \u4e00\u81f4\n    if (!st) {\n        tryTrash(absPath\x2C opts);\n        return { done: true };\n    }\n\n    // \u975e recursive \u5220\u76ee\u5f55 \u2192 \u8ba9\u539f\u751f\u629b EISDIR / ENOTEMPTY\n    if (st.isDirectory() && !recursive) {\n        return { done: false };\n    }\n\n    tryTrash(absPath\x2C opts); // \u5931\u8d25\u65f6\u629b\u9519\uff08fail-closed\uff09\n    return { done: true };\n}\n\nfunction wrappedRmSync(filePath\x2C options) {\n    const absPath = toAbsPath(filePath);\n    const r = tryRm(absPath\x2C options || {});\n    if (r.done) return undefined;\n    return origRmSync(filePath\x2C options);\n}\n\nfunction wrappedRm(filePath\x2C options\x2C callback) {\n    let opts\x2C cb;\n    if (typeof options === 'function') { opts = {}; cb = options; }\n    else { opts = options || {}; cb = callback; }\n\n    // \u4fdd\u6301 Node callback API \u53c2\u6570\u6821\u9a8c\u8bed\u4e49\uff1a\n    // fs.rm \u7684 callback \u5fc5\u586b\uff0c\u7f3a\u5931/\u975e\u51fd\u6570\u65f6\u5e94\u5148\u62a5\u53c2\u6570\u951